# Copy this file to .env.local and fill in the values.

# Pusher (real-time Tic-Tac-Toe)
# Public values: safe to expose to the browser
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=ap2
# Server-only values: never prefix these with NEXT_PUBLIC_
PUSHER_APP_ID=
PUSHER_SECRET=

# Notion (blog) - server-only
NOTION_TOKEN=
NOTION_POSTS_DB_ID=
NOTION_TAGS_DB_ID=
