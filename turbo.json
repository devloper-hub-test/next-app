{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "NOTION_TOKEN",
        "NOTION_POSTS_DB_ID",
        "NOTION_TAGS_DB_ID",
        "PUSHER_APP_ID",
        "PUSHER_SECRET",
        "NEXT_PUBLIC_PUSHER_KEY",
        "NEXT_PUBLIC_PUSHER_CLUSTER",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "KV_REST_API_URL",
        "KV_REST_API_TOKEN"
      ]
    },
    "web#dev": {
      "cache": false
    },
    "web#build": {
      "cache": false,
      "outputs": [
        "dist/**",
        ".next/**"
      ],
      "env": [
        "NOTION_TOKEN",
        "NOTION_POSTS_DB_ID",
        "NOTION_TAGS_DB_ID",
        "PUSHER_APP_ID",
        "PUSHER_SECRET",
        "NEXT_PUBLIC_PUSHER_KEY",
        "NEXT_PUBLIC_PUSHER_CLUSTER",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "KV_REST_API_URL",
        "KV_REST_API_TOKEN"
      ]
    },
    "lint": {},
    "type-check": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
